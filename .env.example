# Copy this template to .env.local, never over the tracked public .env.
# Public browser credentials (same Supabase project as the server)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server only: never prefix these names with VITE_
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
LOVABLE_API_KEY=your-lovable-ai-gateway-key

# Required after applying drizzle/migrations/0006_abuse_protection.sql.
# Generate a random secret of at least 32 characters; use the same value on all replicas.
RATE_LIMIT_HASH_SECRET=

# Empty = shared origin bucket. Only set behind a proxy that OVERWRITES this header
# and cannot be bypassed. Supported: cf-connecting-ip or x-real-ip. Never x-forwarded-for.
RATE_LIMIT_TRUSTED_IP_HEADER=

# Optional: privileged PostgreSQL connection for migration tooling, not app runtime.
LOVABLE_DB_MIGRATION_URL=
